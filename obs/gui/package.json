{
  "name": "@wizard-harness/gui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "dependencies": {
    "@wizard-harness/core": "workspace:^",
    "@wizard-harness/obs-core": "workspace:^",
    "@wizard-harness/plugin-hello": "workspace:^",
    "electron": "^33.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "start": "node ../../scripts/ensure-electron.cjs && pnpm -w build && electron .",
    "build": "esbuild src/renderer.tsx --bundle --format=iife --outfile=electron/renderer.bundle.js --define:process.env.NODE_ENV='\"production\"' --sourcemap",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
